generator client {
  provider     = "prisma-client-js"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       Int    @id @default(autoincrement())
  login    String @unique
  password String
  role     String @default("user")

  orders Order[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products         Product[]
  bannerCategories BannerCategory[]
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  description String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  images ProductImage[]
  items  Item[]

  // Додано поле для зв'язку з характеристиками
  characteristics ProductCharacteristic[]

  bannerProducts    BannerProduct[]
  newsBlockProducts NewsBlockProduct[]

  isOnSale  Boolean @default(false)
  salePrice Float?
}

model ProductCharacteristic {
  id    Int    @id @default(autoincrement())
  name  String // Назва характеристики (напр., "Вага", "Ширина")
  value Float // Числове значення
  unit  String // Одиниця виміру (напр., "кг", "см", "Вт")

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Image {
  id  Int    @id @default(autoincrement())
  url String @unique

  productImages   ProductImage[]
  bannerImages    BannerImage[]
  newsImages      NewsImage[]
  newsBlockImages NewsBlockImage[] // Додано зворотний зв'язок для блоків новин
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  imageId   Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([productId, imageId])
}

model Banner {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  text        String
  order       Int    @default(0)

  images           BannerImage[]
  products         BannerProduct[]
  bannerCategories BannerCategory[]
}

model BannerProduct {
  bannerId  Int
  productId Int
  banner    Banner  @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bannerId, productId])
}

model BannerCategory {
  bannerId   Int
  categoryId Int

  banner   Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bannerId, categoryId])
}

model BannerImage {
  id Int @id @default(autoincrement())

  bannerId Int
  imageId  Int

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  image  Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([bannerId, imageId])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  tag         String   @default("Новини")
  date        DateTime @default(now())

  contentBlocks NewsBlock[]
  images        NewsImage[] // Додано зворотний зв'язок для NewsImage
}

model NewsBlock {
  id    Int     @id @default(autoincrement())
  title String?
  text  String?
  order Int     @default(0)

  newsId Int
  news   News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  images   NewsBlockImage[]
  products NewsBlockProduct[]
}

model NewsBlockImage {
  id      Int @id @default(autoincrement())
  blockId Int
  imageId Int

  block NewsBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  image Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model NewsBlockProduct {
  blockId   Int
  productId Int

  block   NewsBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([blockId, productId])
}

model NewsImage {
  id Int @id @default(autoincrement())

  newsId  Int
  imageId Int

  news  News  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([newsId, imageId])
}

model Order {
  id     Int      @id @default(autoincrement())
  userId Int
  user   User     @relation(fields: [userId], references: [id])
  sum    Float
  date   DateTime @default(now())

  customerType String
  customerName String
  email        String
  phone        String
  address      String

  edrpou    String?
  iban      String?
  bank      String?
  taxStatus String?

  items Item[]
}

model Item {
  id Int @id @default(autoincrement())

  orderId   Int
  productId Int

  quantity Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}
